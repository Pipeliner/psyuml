{
  "version": "0.1.0",
  "language": "en",
  "diagram": "process-loop",
  "meta": {
    "title": "PTSD maintenance (Ehlers–Clark)",
    "disclaimer": "This map supports, and does not replace, professional care. Pace trauma work; resource first.",
    "safety": { "psychosisFlag": false, "acuteRiskFlag": false }
  },
  "nodes": [
    { "id": "threat", "kind": "state", "label": { "clinician": { "en": "Sense of current threat" }, "client": { "en": "Danger feels here now" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "intrusions", "kind": "state", "label": { "clinician": { "en": "Intrusions / flashbacks" }, "client": { "en": "Flashbacks, images" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "strategies", "kind": "state", "label": { "clinician": { "en": "Avoid; suppress; scan" }, "client": { "en": "Avoid, watch for danger" } }, "properties": { "epistemicStatus": "observed" } },
    { "id": "out", "kind": "resource", "label": { "clinician": { "en": "Update the memory; drop avoidance (with support)" }, "client": { "en": "It's then, not now" } }, "properties": { "epistemicStatus": "planned" } }
  ],
  "edges": [
    { "id": "e1", "kind": "sequential", "source": "threat", "target": "intrusions", "trigger": { "clinician": { "en": "a reminder" } } },
    { "id": "e2", "kind": "sequential", "source": "intrusions", "target": "strategies" },
    { "id": "e3", "kind": "sequential", "source": "strategies", "target": "threat", "loop": "R", "loopTopology": "trap" },
    { "id": "x1", "kind": "exit", "source": "strategies", "target": "out", "label": { "clinician": { "en": "approach + update, paced" } } }
  ]
}
