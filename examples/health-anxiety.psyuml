{
  "version": "0.1.0",
  "language": "en",
  "diagram": "process-loop",
  "meta": {
    "title": "Health-anxiety loop",
    "disclaimer": "This map supports, and does not replace, professional care.",
    "safety": { "psychosisFlag": false, "acuteRiskFlag": false }
  },
  "nodes": [
    { "id": "sensation", "kind": "state", "label": { "clinician": { "en": "Notices a body sensation" }, "client": { "en": "A funny feeling" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "appraise", "kind": "state", "label": { "clinician": { "en": "\"Something is wrong with me\"" }, "client": { "en": "\"Something's wrong\"" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "check", "kind": "state", "label": { "clinician": { "en": "Check body, Google, seek reassurance" }, "client": { "en": "Check, Google, reassure" } }, "properties": { "epistemicStatus": "observed" } },
    { "id": "out", "kind": "resource", "label": { "clinician": { "en": "Sit with the uncertainty; drop the checking" }, "client": { "en": "Let it be uncertain" } }, "properties": { "epistemicStatus": "planned" } }
  ],
  "edges": [
    { "id": "e1", "kind": "sequential", "source": "sensation", "target": "appraise", "trigger": { "clinician": { "en": "a twinge" } } },
    { "id": "e2", "kind": "reciprocal", "source": "appraise", "target": "check" },
    { "id": "e3", "kind": "sequential", "source": "check", "target": "sensation", "loop": "R", "loopTopology": "trap", "label": { "clinician": { "en": "checking heightens noticing" } } },
    { "id": "x1", "kind": "exit", "source": "check", "target": "out", "label": { "clinician": { "en": "drop the safety behaviour" } } }
  ]
}
