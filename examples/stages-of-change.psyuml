{
  "version": "0.1.0",
  "language": "en",
  "diagram": "process-loop",
  "meta": {
    "title": "Stages of change (TTM) — contested as a stage model",
    "disclaimer": "This map supports, and does not replace, professional care. The 'stages' are a popular heuristic, not a settled theory.",
    "safety": { "psychosisFlag": false, "acuteRiskFlag": false }
  },
  "nodes": [
    { "id": "pre", "kind": "state", "label": { "clinician": { "en": "Pre-contemplation: not yet" }, "client": { "en": "Not thinking about it" } }, "properties": { "epistemicStatus": "observed" } },
    { "id": "contem", "kind": "state", "label": { "clinician": { "en": "Contemplation: weighing it up" }, "client": { "en": "Weighing it up" } }, "properties": { "epistemicStatus": "observed" } },
    { "id": "prep", "kind": "state", "label": { "clinician": { "en": "Preparation: getting ready" }, "client": { "en": "Getting ready" } }, "properties": { "epistemicStatus": "observed" } },
    { "id": "action", "kind": "state", "label": { "clinician": { "en": "Action: doing it" }, "client": { "en": "Doing it" } }, "properties": { "epistemicStatus": "observed" } },
    { "id": "maint", "kind": "state", "label": { "clinician": { "en": "Maintenance: keeping it up" }, "client": { "en": "Keeping it up" } }, "properties": { "epistemicStatus": "observed" } },
    { "id": "out", "kind": "resource", "label": { "clinician": { "en": "A lapse is normal — re-enter, don't quit" }, "client": { "en": "Slips are normal; start again" } }, "properties": { "epistemicStatus": "planned" } }
  ],
  "edges": [
    { "id": "e1", "kind": "sequential", "source": "pre", "target": "contem" },
    { "id": "e2", "kind": "sequential", "source": "contem", "target": "prep" },
    { "id": "e3", "kind": "sequential", "source": "prep", "target": "action" },
    { "id": "e4", "kind": "sequential", "source": "action", "target": "maint" },
    { "id": "e5", "kind": "sequential", "source": "maint", "target": "pre", "loop": "R", "label": { "clinician": { "en": "lapse → re-enter" } } },
    { "id": "x1", "kind": "exit", "source": "maint", "target": "out", "label": { "clinician": { "en": "self-compassion" } } }
  ]
}
