{
  "version": "0.1.0",
  "language": "en",
  "diagram": "process-loop",
  "meta": {
    "title": "Safety-behaviour maintenance cycle",
    "disclaimer": "This map supports, and does not replace, professional care.",
    "safety": { "psychosisFlag": false, "acuteRiskFlag": false }
  },
  "nodes": [
    { "id": "belief", "kind": "state", "label": { "clinician": { "en": "Threat belief: \"I'm in danger\"" }, "client": { "en": "\"I'm in danger\"" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "anxiety", "kind": "state", "label": { "clinician": { "en": "Anxiety rises" }, "client": { "en": "Anxiety" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "safety", "kind": "state", "label": { "clinician": { "en": "Safety behaviour: avoid, check, grip on" }, "client": { "en": "Avoid / check / hold on" } }, "properties": { "epistemicStatus": "observed" } },
    { "id": "blocked", "kind": "state", "label": { "clinician": { "en": "Disconfirmation blocked — \"it only went OK because I…\"" }, "client": { "en": "\"It was fine only because I…\"" } }, "properties": { "epistemicStatus": "inferred" } },
    { "id": "out", "kind": "resource", "label": { "clinician": { "en": "Drop the safety behaviour; let the fear be tested" }, "client": { "en": "Test the fear" } }, "properties": { "epistemicStatus": "planned" } }
  ],
  "edges": [
    { "id": "e1", "kind": "sequential", "source": "belief", "target": "anxiety", "trigger": { "clinician": { "en": "a feared situation" } } },
    { "id": "e2", "kind": "sequential", "source": "anxiety", "target": "safety" },
    { "id": "e3", "kind": "sequential", "source": "safety", "target": "blocked" },
    { "id": "e4", "kind": "sequential", "source": "blocked", "target": "belief", "loop": "R", "loopTopology": "trap", "label": { "clinician": { "en": "belief never disconfirmed" } } },
    { "id": "x1", "kind": "exit", "source": "blocked", "target": "out", "label": { "clinician": { "en": "test it — drop the safety behaviour" } } }
  ]
}
