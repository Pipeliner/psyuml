{
  "version": "0.1.0",
  "language": "en",
  "diagram": "process-loop",
  "meta": {
    "title": "Eating disorder — transdiagnostic maintenance (Fairburn)",
    "disclaimer": "This map supports, and does not replace, professional care.",
    "safety": { "psychosisFlag": false, "acuteRiskFlag": false }
  },
  "nodes": [
    { "id": "overval", "kind": "state", "label": { "clinician": { "en": "Over-evaluation of shape, weight & control" }, "client": { "en": "My worth = my shape/control" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "diet", "kind": "state", "label": { "clinician": { "en": "Strict dieting / rigid rules" }, "client": { "en": "Strict food rules" } }, "properties": { "epistemicStatus": "observed" } },
    { "id": "binge", "kind": "state", "label": { "clinician": { "en": "Binge eating (rules broken)" }, "client": { "en": "Bingeing" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "compensate", "kind": "state", "label": { "clinician": { "en": "Compensatory behaviours; checking" }, "client": { "en": "Making up for it" } }, "properties": { "epistemicStatus": "observed" } },
    { "id": "out", "kind": "resource", "label": { "clinician": { "en": "Regular eating; broaden self-evaluation" }, "client": { "en": "Eat regularly; I'm more than this" } }, "properties": { "epistemicStatus": "planned" } }
  ],
  "edges": [
    { "id": "e1", "kind": "sequential", "source": "overval", "target": "diet" },
    { "id": "e2", "kind": "sequential", "source": "diet", "target": "binge", "trigger": { "clinician": { "en": "a rule broken" } } },
    { "id": "e3", "kind": "sequential", "source": "binge", "target": "compensate" },
    { "id": "e4", "kind": "sequential", "source": "compensate", "target": "overval", "loop": "R", "loopTopology": "trap", "label": { "clinician": { "en": "confirms the over-evaluation" } } },
    { "id": "x1", "kind": "exit", "source": "compensate", "target": "out", "label": { "clinician": { "en": "regular eating instead" } } }
  ]
}
