{
  "version": "0.1.0",
  "language": "en",
  "diagram": "process-loop",
  "meta": {
    "title": "Low mood — a maintaining cycle (vicious flower)",
    "disclaimer": "This map supports, and does not replace, professional care.",
    "safety": { "psychosisFlag": false, "acuteRiskFlag": false }
  },
  "nodes": [
    { "id": "belief", "kind": "state", "label": { "clinician": { "en": "\"I'm worthless / a failure\"" }, "client": { "en": "\"I'm not good enough\"" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "withdraw", "kind": "state", "label": { "clinician": { "en": "Withdraw, stop activities" }, "client": { "en": "Pull back, do less" } }, "properties": { "epistemicStatus": "observed" } },
    { "id": "rewards", "kind": "state", "label": { "clinician": { "en": "Fewer good experiences" }, "client": { "en": "Fewer good moments" } }, "properties": { "epistemicStatus": "observed" } },
    { "id": "rumination", "kind": "state", "label": { "clinician": { "en": "Dwelling on failure" }, "client": { "en": "Going over it" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "out", "kind": "resource", "label": { "clinician": { "en": "Small valued action (behavioural activation)" }, "client": { "en": "One small valued step" } }, "properties": { "epistemicStatus": "planned" } }
  ],
  "edges": [
    { "id": "e1", "kind": "sequential", "source": "belief", "target": "withdraw" },
    { "id": "e2", "kind": "sequential", "source": "withdraw", "target": "rewards" },
    { "id": "e3", "kind": "sequential", "source": "rewards", "target": "belief", "loop": "R", "label": { "clinician": { "en": "confirms the belief" } } },
    { "id": "e4", "kind": "reciprocal", "source": "belief", "target": "rumination" },
    { "id": "x1", "kind": "exit", "source": "withdraw", "target": "out", "label": { "clinician": { "en": "act against the pull" } } }
  ]
}
