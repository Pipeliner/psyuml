{
  "version": "0.1.0",
  "language": "en",
  "diagram": "intervention-sequence",
  "meta": {
    "title": "SORC functional analysis",
    "disclaimer": "This map supports, and does not replace, professional care. A shared map of one episode, not blame.",
    "safety": { "psychosisFlag": false, "acuteRiskFlag": false }
  },
  "bands": [
    { "id": "chain", "order": 0, "label": { "clinician": { "en": "The episode" } } },
    { "id": "change", "order": 1, "label": { "clinician": { "en": "Where to intervene" } } }
  ],
  "nodes": [
    { "id": "s", "kind": "intervention", "bandId": "chain", "label": { "clinician": { "en": "S — Stimulus: antecedent / cue" }, "client": { "en": "What set it off" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "o", "kind": "intervention", "bandId": "chain", "label": { "clinician": { "en": "O — Organism: mood, beliefs, biology" }, "client": { "en": "How I was already" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "r", "kind": "intervention", "bandId": "chain", "label": { "clinician": { "en": "R — Response: what I did" }, "client": { "en": "What I did" } }, "properties": { "epistemicStatus": "observed" } },
    { "id": "c", "kind": "intervention", "bandId": "chain", "label": { "clinician": { "en": "C — Consequence: short-term relief, long-term cost" }, "client": { "en": "Relief now, cost later" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "alt", "kind": "intervention", "bandId": "change", "label": { "clinician": { "en": "Change the antecedent or the response" }, "client": { "en": "Try it differently" } }, "properties": { "epistemicStatus": "planned" } }
  ],
  "edges": [
    { "id": "e1", "kind": "sequential", "source": "s", "target": "o" },
    { "id": "e2", "kind": "sequential", "source": "o", "target": "r" },
    { "id": "e3", "kind": "sequential", "source": "r", "target": "c" },
    { "id": "x1", "kind": "sequential", "source": "r", "target": "alt", "label": { "clinician": { "en": "intervene here" } } }
  ]
}
