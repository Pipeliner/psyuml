{
  "version": "0.1.0",
  "language": "en",
  "diagram": "process-loop",
  "meta": {
    "title": "Snag (CAT) — success undone",
    "disclaimer": "This map supports, and does not replace, professional care.",
    "safety": { "psychosisFlag": false, "acuteRiskFlag": false }
  },
  "nodes": [
    { "id": "goal", "kind": "state", "label": { "clinician": { "en": "Move toward a wanted goal" }, "client": { "en": "Go for what I want" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "progress", "kind": "state", "label": { "clinician": { "en": "Things start to go well" }, "client": { "en": "It's going well" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "guilt", "kind": "state", "label": { "clinician": { "en": "Guilt: \"I don't deserve it\" / others will lose out" }, "client": { "en": "\"I don't deserve it\"" } }, "properties": { "epistemicStatus": "inferred" } },
    { "id": "undo", "kind": "state", "label": { "clinician": { "en": "Pull back / sabotage the gain" }, "client": { "en": "Undo it" } }, "properties": { "epistemicStatus": "observed" } },
    { "id": "out", "kind": "resource", "label": { "clinician": { "en": "Allow good things; tolerate the guilt" }, "client": { "en": "Let myself have it" } }, "properties": { "epistemicStatus": "planned" } }
  ],
  "edges": [
    { "id": "e1", "kind": "sequential", "source": "goal", "target": "progress" },
    { "id": "e2", "kind": "sequential", "source": "progress", "target": "guilt" },
    { "id": "e3", "kind": "sequential", "source": "guilt", "target": "undo" },
    { "id": "e4", "kind": "sequential", "source": "undo", "target": "goal", "loop": "B", "loopTopology": "snag", "label": { "clinician": { "en": "gain undone" } } },
    { "id": "x1", "kind": "exit", "source": "undo", "target": "out", "label": { "clinician": { "en": "allow the good thing" } } }
  ]
}
