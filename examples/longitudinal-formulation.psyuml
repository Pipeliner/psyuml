{
  "version": "0.1.0",
  "language": "en",
  "diagram": "timeline",
  "meta": {
    "title": "Longitudinal formulation — how the past shapes the present",
    "disclaimer": "This map supports, and does not replace, professional care. Belief links are tentative hypotheses.",
    "safety": { "psychosisFlag": false, "acuteRiskFlag": false }
  },
  "bands": [
    { "id": "early", "order": 0, "label": { "clinician": { "en": "Early experiences" } } },
    { "id": "core", "order": 1, "label": { "clinician": { "en": "Core beliefs" } } },
    { "id": "rules", "order": 2, "label": { "clinician": { "en": "Rules / strategies" } } },
    { "id": "now", "order": 3, "label": { "clinician": { "en": "Now (triggers)" } } }
  ],
  "nodes": [
    { "id": "a0", "kind": "state", "stereotype": "action", "bandId": "early", "label": { "clinician": { "en": "Harsh criticism" }, "client": { "en": "Often criticised" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "a1", "kind": "state", "stereotype": "action", "bandId": "core", "label": { "clinician": { "en": "Try to be perfect" }, "client": { "en": "Try to get it perfect" } }, "properties": { "epistemicStatus": "inferred" } },
    { "id": "a2", "kind": "state", "stereotype": "action", "bandId": "rules", "label": { "clinician": { "en": "Over-prepare, avoid risk" }, "client": { "en": "Over-prepare, play safe" } }, "properties": { "epistemicStatus": "observed" } },
    { "id": "a3", "kind": "state", "stereotype": "action", "bandId": "now", "label": { "clinician": { "en": "Procrastinate, then panic" }, "client": { "en": "Put off, then panic" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "i0", "kind": "state", "stereotype": "identity", "bandId": "early", "label": { "clinician": { "en": "\"I'm not safe\"" } }, "properties": { "epistemicStatus": "inferred" } },
    { "id": "i1", "kind": "state", "stereotype": "identity", "bandId": "core", "label": { "clinician": { "en": "\"I'm not good enough\"" } }, "properties": { "epistemicStatus": "inferred" } },
    { "id": "i2", "kind": "state", "stereotype": "identity", "bandId": "rules", "label": { "clinician": { "en": "\"If I fail, I'm worthless\"" } }, "properties": { "epistemicStatus": "inferred" } },
    { "id": "i3", "kind": "state", "stereotype": "identity", "bandId": "now", "label": { "clinician": { "en": "\"See — I can't cope\"" } }, "properties": { "epistemicStatus": "reported" } }
  ],
  "edges": [
    { "id": "t1", "kind": "sequential", "source": "a0", "target": "a1" },
    { "id": "t2", "kind": "sequential", "source": "a1", "target": "a2" },
    { "id": "t3", "kind": "sequential", "source": "a2", "target": "a3" }
  ]
