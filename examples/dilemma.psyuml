{
  "version": "0.1.0",
  "language": "en",
  "diagram": "process-loop",
  "meta": {
    "title": "Dilemma (CAT) — a false either/or",
    "disclaimer": "This map supports, and does not replace, professional care.",
    "safety": { "psychosisFlag": false, "acuteRiskFlag": false }
  },
  "nodes": [
    { "id": "bind", "kind": "state", "label": { "clinician": { "en": "The bind: \"either I comply, or I'm rejected\"" }, "client": { "en": "\"Comply, or be rejected\"" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "comply", "kind": "state", "label": { "clinician": { "en": "Comply / try harder to please" }, "client": { "en": "Go along with it" } }, "properties": { "epistemicStatus": "observed" } },
    { "id": "drained", "kind": "state", "label": { "clinician": { "en": "Drained, resentful, unseen" }, "client": { "en": "Drained and resentful" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "out", "kind": "resource", "label": { "clinician": { "en": "Name the false either/or; find a third option" }, "client": { "en": "There's a third way" } }, "properties": { "epistemicStatus": "planned" } }
  ],
  "edges": [
    { "id": "e1", "kind": "sequential", "source": "bind", "target": "comply" },
    { "id": "e2", "kind": "sequential", "source": "comply", "target": "drained" },
    { "id": "e3", "kind": "sequential", "source": "drained", "target": "bind", "loop": "B", "loopTopology": "dilemma", "label": { "clinician": { "en": "the bind repeats" } } },
    { "id": "x1", "kind": "exit", "source": "drained", "target": "out", "label": { "clinician": { "en": "name the false either/or" } } }
  ]
}
