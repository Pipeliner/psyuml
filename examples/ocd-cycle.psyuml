{
  "version": "0.1.0",
  "language": "en",
  "diagram": "process-loop",
  "meta": {
    "title": "OCD maintenance cycle",
    "disclaimer": "This map supports, and does not replace, professional care.",
    "safety": {
      "psychosisFlag": false,
      "acuteRiskFlag": false
    }
  },
  "nodes": [
    {
      "id": "intrusion",
      "kind": "state",
      "label": {
        "clinician": {
          "en": "Intrusive thought / image"
        },
        "client": {
          "en": "Unwanted thought"
        }
      },
      "properties": {
        "epistemicStatus": "reported"
      }
    },
    {
      "id": "appraisal",
      "kind": "state",
      "label": {
        "clinician": {
          "en": "\"This means I'm dangerous / responsible\""
        },
        "client": {
          "en": "\"This matters; it's my fault\""
        }
      },
      "properties": {
        "epistemicStatus": "reported"
      }
    },
    {
      "id": "distress",
      "kind": "state",
      "label": {
        "clinician": {
          "en": "Anxiety, guilt"
        },
        "client": {
          "en": "Anxiety, guilt"
        }
      },
      "properties": {
        "epistemicStatus": "reported"
      }
    },
    {
      "id": "compulsion",
      "kind": "state",
      "label": {
        "clinician": {
          "en": "Check, wash, reassure, avoid"
        },
        "client": {
          "en": "Check, wash, avoid"
        }
      },
      "properties": {
        "epistemicStatus": "observed"
      }
    },
    {
      "id": "out",
      "kind": "resource",
      "label": {
        "clinician": {
          "en": "Allow the thought; drop the ritual (response prevention)"
        },
        "client": {
          "en": "Let it be; skip the ritual"
        }
      },
      "properties": {
        "epistemicStatus": "planned"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "kind": "sequential",
      "source": "intrusion",
      "target": "appraisal"
    },
    {
      "id": "e2",
      "kind": "reciprocal",
      "source": "appraisal",
      "target": "distress"
    },
    {
      "id": "e3",
      "kind": "sequential",
      "source": "distress",
      "target": "compulsion"
    },
    {
      "id": "e4",
      "kind": "sequential",
      "source": "compulsion",
      "target": "intrusion",
      "loop": "R"
    },
    {
      "id": "x1",
      "kind": "exit",
      "source": "compulsion",
      "target": "out",
      "label": {
        "clinician": {
          "en": "response prevention"
        }
      }
    }
  ]
}
