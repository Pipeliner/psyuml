  "diagram": "ritual",
  "meta": {
    "title": "Rite of passage — separation, threshold, return",
    "disclaimer": "Co-created and consent-based. A ritual eases subjective meaning and anxiety — it is not a medical treatment.",
    "ritual": {
      "framing": "Affects subjective anxiety, control and meaning — NOT objective disease markers. Never offered as a cure.",
      "secularVariant": "Quiet remembering: name what is ending, keep one object, ask trusted people to witness. No belief required."
    },
    "consent": { "obtained": true, "scope": "Devised and performed with the client; symbols are theirs" },
    "safety": { "psychosisFlag": false, "acuteRiskFlag": false }
  },
  "bands": [
    { "id": "separation", "order": 0, "label": { "clinician": { "en": "Separation" } } },
    { "id": "liminal", "order": 1, "label": { "clinician": { "en": "Liminal (threshold)" } } },
    { "id": "incorporation", "order": 2, "label": { "clinician": { "en": "Incorporation (return)" } } }
  ],
  "nodes": [
    { "id": "sep1", "kind": "intervention", "bandId": "separation", "tier": 1, "label": { "clinician": { "en": "Name what is ending (light a candle)" } }, "properties": { "epistemicStatus": "symbolic" } },
    { "id": "sep2", "kind": "intervention", "bandId": "separation", "tier": 1, "label": { "clinician": { "en": "Cross a marked threshold" } }, "properties": { "epistemicStatus": "symbolic" } },
    { "id": "lim1", "kind": "intervention", "bandId": "liminal", "tier": 1, "label": { "clinician": { "en": "Letter to the younger self" } }, "properties": { "epistemicStatus": "symbolic" } },
    { "id": "lim2", "kind": "intervention", "bandId": "liminal", "tier": 1, "label": { "clinician": { "en": "Read aloud, then release safely" } }, "properties": { "epistemicStatus": "symbolic" } },
    { "id": "lim3", "kind": "intervention", "bandId": "liminal", "tier": 1, "label": { "clinician": { "en": "Sit in the not-knowing" } }, "properties": { "epistemicStatus": "symbolic" } },
    { "id": "inc1", "kind": "intervention", "bandId": "incorporation", "tier": 1, "label": { "clinician": { "en": "Receive a token to carry" } }, "properties": { "epistemicStatus": "symbolic" } },
    { "id": "inc2", "kind": "intervention", "bandId": "incorporation", "tier": 1, "label": { "clinician": { "en": "Witnesses affirm the new chapter" } }, "properties": { "epistemicStatus": "tradition-claimed", "provenance": ["tradition:rite-of-passage"] } }
