    { "id": "support", "order": 2, "label": { "clinician": { "en": "Support" } } }
  ],
  "nodes": [
    { "id": "t1", "kind": "intervention", "bandId": "therapist", "tier": 1, "label": { "clinician": { "en": "Phase 1: Safety & stabilization" }, "client": { "en": "Get steady & safe" } }, "properties": { "epistemicStatus": "planned" } },
    { "id": "c1", "kind": "intervention", "bandId": "client", "tier": 1, "label": { "clinician": { "en": "Grounding + sleep routine" }, "client": { "en": "Grounding, better sleep" } }, "properties": { "epistemicStatus": "planned" } },
    { "id": "s1", "kind": "resource", "bandId": "support", "tier": 1, "label": { "clinician": { "en": "Safe person on call" }, "client": { "en": "Someone I can call" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "t2", "kind": "intervention", "bandId": "therapist", "tier": 1, "label": { "clinician": { "en": "Phase 2: Process the memory (EMDR / TF-CBT)" }, "client": { "en": "Work the memory through" } }, "properties": { "epistemicStatus": "planned" } },
    { "id": "c2", "kind": "intervention", "bandId": "client", "tier": 1, "label": { "clinician": { "en": "Window-of-tolerance skills" }, "client": { "en": "Stay in my window" } }, "properties": { "epistemicStatus": "planned" } },
    { "id": "t3", "kind": "intervention", "bandId": "therapist", "tier": 1, "label": { "clinician": { "en": "Phase 3: Reconnect & make meaning" }, "client": { "en": "Rebuild my life" } }, "properties": { "epistemicStatus": "planned" } },
    { "id": "c3", "kind": "intervention", "bandId": "client", "tier": 1, "label": { "clinician": { "en": "Values-led action" }, "client": { "en": "Do what matters" } }, "properties": { "epistemicStatus": "planned" } },
