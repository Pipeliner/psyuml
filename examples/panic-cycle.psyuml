{
  "version": "0.1.0",
  "language": "en",
  "diagram": "process-loop",
  "meta": {
    "title": "Panic — the fear-of-fear cycle",
    "disclaimer": "This map supports, and does not replace, professional care.",
    "safety": {
      "psychosisFlag": false,
      "acuteRiskFlag": false
    }
  },
  "nodes": [
    {
      "id": "trigger",
      "kind": "state",
      "label": {
        "clinician": {
          "en": "Body sensation: racing heart"
        },
        "client": {
          "en": "Heart races"
        }
      },
      "properties": {
        "epistemicStatus": "reported"
      }
    },
    {
      "id": "thought",
      "kind": "state",
      "label": {
        "clinician": {
          "en": "\"I'm having a heart attack\""
        },
        "client": {
          "en": "\"Something's badly wrong\""
        }
      },
      "properties": {
        "epistemicStatus": "reported"
      }
    },
    {
      "id": "panic",
      "kind": "state",
      "label": {
        "clinician": {
          "en": "Panic rises"
        },
        "client": {
          "en": "Panic"
        }
      },
      "properties": {
        "epistemicStatus": "reported"
      }
    },
    {
      "id": "safety",
      "kind": "state",
      "label": {
        "clinician": {
          "en": "Check pulse, escape, reassure"
        },
        "client": {
          "en": "Check, escape, reassure"
        }
      },
      "properties": {
        "epistemicStatus": "observed"
      }
    },
    {
      "id": "out",
      "kind": "resource",
      "label": {
        "clinician": {
          "en": "Check facts; it's anxiety, not danger; ride the wave"
        },
        "client": {
          "en": "Ride it out"
        }
      },
      "properties": {
        "epistemicStatus": "planned"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "kind": "sequential",
      "source": "trigger",
      "target": "thought",
      "trigger": {
        "clinician": {
          "en": "notice"
        }
      }
    },
    {
      "id": "e2",
      "kind": "reciprocal",
      "source": "thought",
      "target": "panic"
    },
    {
      "id": "e3",
      "kind": "sequential",
      "source": "panic",
      "target": "safety"
    },
    {
      "id": "e4",
      "kind": "sequential",
      "source": "safety",
      "target": "trigger",
      "loop": "R"
    },
    {
      "id": "x1",
      "kind": "exit",
      "source": "safety",
      "target": "out",
      "label": {
        "clinician": {
          "en": "drop safety behaviours"
        }
      }
    }
  ]
}
