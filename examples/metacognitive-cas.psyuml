{
  "version": "0.1.0",
  "language": "en",
  "diagram": "process-loop",
  "meta": {
    "title": "Metacognitive CAS (Wells)",
    "disclaimer": "This map supports, and does not replace, professional care.",
    "safety": { "psychosisFlag": false, "acuteRiskFlag": false }
  },
  "nodes": [
    { "id": "trigger", "kind": "state", "label": { "clinician": { "en": "Trigger thought / intrusion" }, "client": { "en": "A worrying thought" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "cas", "kind": "state", "label": { "clinician": { "en": "Worry / rumination (the CAS)" }, "client": { "en": "Worrying it over" } }, "properties": { "epistemicStatus": "reported" } },
    { "id": "monitor", "kind": "state", "label": { "clinician": { "en": "Threat monitoring; thought suppression" }, "client": { "en": "Watching for danger" } }, "properties": { "epistemicStatus": "observed" } },
    { "id": "belief", "kind": "state", "label": { "clinician": { "en": "Beliefs about worry confirmed (uncontrollable / useful)" }, "client": { "en": "\"I can't stop, and it helps\"" } }, "properties": { "epistemicStatus": "inferred" } },
    { "id": "out", "kind": "resource", "label": { "clinician": { "en": "Detached mindfulness; postpone worry" }, "client": { "en": "Let thoughts pass; park the worry" } }, "properties": { "epistemicStatus": "planned" } }
  ],
  "edges": [
    { "id": "e1", "kind": "sequential", "source": "trigger", "target": "cas" },
    { "id": "e2", "kind": "sequential", "source": "cas", "target": "monitor" },
    { "id": "e3", "kind": "sequential", "source": "monitor", "target": "belief" },
    { "id": "e4", "kind": "sequential", "source": "belief", "target": "trigger", "loop": "R", "loopTopology": "trap", "label": { "clinician": { "en": "primes the next trigger" } } },
    { "id": "x1", "kind": "exit", "source": "belief", "target": "out", "label": { "clinician": { "en": "step out of the CAS" } } }
  ]
}
