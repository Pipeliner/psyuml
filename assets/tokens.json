{
  "$comment": "PsyUML design tokens. Encodes spec §D: a colorblind-safe (Okabe–Ito) palette where every concept's color is ALWAYS redundant with a non-color (shape/pattern/label) encoding. No meaning is ever carried by color alone.",
  "palette": {
    "name": "Okabe–Ito (colorblind-safe)",
    "colors": {
      "black": "#000000",
      "orange": "#E69F00",
      "skyBlue": "#56B4E9",
      "bluishGreen": "#009E73",
      "yellow": "#F0E442",
      "blue": "#0072B2",
      "vermillion": "#D55E00",
      "reddishPurple": "#CC79A7",
      "grey": "#999999"
    }
  },
  "concepts": {
    "stateNeutral": { "color": "grey", "nonColor": "rounded rectangle + label", "glyph": "state" },
    "agentPart": { "color": "blue", "nonColor": "circle + name", "glyph": "agent" },
    "selfCore": { "color": "orange", "nonColor": "double ring + centre dot", "glyph": "self" },
    "resourceAnchor": { "color": "bluishGreen", "nonColor": "diamond + thick border", "glyph": "resource" },
    "intervention": { "color": "reddishPurple", "nonColor": "hexagon + hatched fill", "glyph": "intervention" },
    "threatRisk": { "color": "vermillion", "nonColor": "triangle/flag + \"!\" + word", "glyph": "phase-band" },
    "soothing": { "color": "skyBlue", "nonColor": "wavy underline", "glyph": "observing-eye" }
  }
}
